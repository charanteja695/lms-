# ============================================================================================
# billing-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-billing-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_billing
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
WRITE_RATE_LIMIT_PER_USER_PER_MINUTE=60

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=billing-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14
WORKER_POLL_SECONDS=2.0
SWEEP_INTERVAL_SECONDS=600.0
HOUSEKEEPING_INTERVAL_SECONDS=3600.0

# --- Tax and invoicing (docs/PRODUCT.md §5.10) ---
SELLER_LEGAL_NAME=LMS Platform Pvt Ltd
SELLER_GSTIN=29AAAAA0000A1Z5
SELLER_STATE=Karnataka
GST_RATE_PERCENT=18
SAC_CODE=998439
INVOICE_DUE_DAYS=15
QUOTE_VALID_DAYS=14
MAX_QUOTE_LINES=20

# --- Payment gateway: contract only (D13). Empty URL = not configured; manual payments always work. ---
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_TIMEOUT_SECONDS=15.0
PAYMENT_WEBHOOK_SECRET=**********
# Razorpay (the learner store's checkout; also used for invoice payments when its keys are set). The key id is public
# (the browser's checkout needs it); the key secret signs and verifies. PAYMENT_WEBHOOK_SECRET is Razorpay's webhook secret.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com/v1
SELLER_DISPLAY_NAME=LMS
LEARNER_ACCESS_DAYS=365
