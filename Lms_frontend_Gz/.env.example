# Frontend settings. Copy to .env and edit there; the code reads every value from here.
# VITE_* values are embedded in the browser bundle, so never put secrets in this file.

# --- App ---
VITE_APP_NAME=LMS
# The company shown under the app name (optional: leave empty to hide it).
VITE_ORGANIZATION_NAME=GenZ Technologies
# API base path used by the browser. In development the dev server proxies it to the API gateway (DEV_API_PROXY_TARGET), which routes each path to its service.
VITE_API_BASE_URL=/api/v1
# How often the header bell re-checks the unread count (seconds).
VITE_NOTIFICATION_POLL_SECONDS=60
# How often open conversations (support tickets) re-check for new replies while the tab is focused (seconds).
VITE_LIVE_REFRESH_SECONDS=30

# --- Development server only (not included in the bundle) ---
DEV_SERVER_PORT=3000
DEV_API_PROXY_TARGET=http://localhost:8000
