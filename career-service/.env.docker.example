# ============================================================================================
# career-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-career-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_career
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access
INTERNAL_SERVICE_TOKEN=**********

# --- ai-gateway (every model call; this service holds no provider key) ---
AI_GATEWAY_URL=http://ai-gateway:8000
AI_GATEWAY_TIMEOUT_SECONDS=45.0
PLATFORM_ORGANIZATION_ID=1755000000000001
MAX_TOKENS=900

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
WRITE_RATE_LIMIT_PER_USER_PER_MINUTE=60
AI_RATE_LIMIT_PER_USER_PER_HOUR=30
EXPORT_RATE_LIMIT_PER_USER_PER_HOUR=60
PUBLIC_RATE_LIMIT_PER_IP_PER_MINUTE=60

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=career-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14
WORKER_POLL_SECONDS=2.0
HOUSEKEEPING_INTERVAL_SECONDS=3600.0

# --- Profile and resumes ---
MAX_PROFILE_ITEMS_PER_KIND=50
MAX_RESUMES_PER_USER=10
MAX_VERSIONS_PER_RESUME=50
MAX_BULLETS_PER_ITEM=8
MAX_BULLET_CHARS=300
MAX_JOB_DESCRIPTION_CHARS=8000
SHARE_DEFAULT_DAYS=30
# A skill score shows a percentile only when at least this many students have a score for the course; a percentile
# among five people would be noise, and would let a student be identified from the numbers.
PERCENTILE_MIN_COHORT=20
