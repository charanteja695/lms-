# ============================================================================================
# support-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-support-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_support
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access
INTERNAL_SERVICE_TOKEN=**********

# --- ai-tutor-service: the conversation behind a tutor hand-off, read with the internal token ---
AI_TUTOR_SERVICE_URL=http://localhost:8011
AI_TUTOR_TIMEOUT_SECONDS=5.0

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
TICKET_RATE_LIMIT_PER_USER_PER_HOUR=10
REPLY_RATE_LIMIT_PER_USER_PER_MINUTE=20
AGENT_RATE_LIMIT_PER_HOUR=2000

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=support-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14
WORKER_POLL_SECONDS=2.0
HOUSEKEEPING_INTERVAL_SECONDS=3600.0

# --- Ticket lifecycle ---
MAX_SUBJECT_CHARS=200
MAX_BODY_CHARS=6000
# A resolved ticket the student does not answer is closed after this long; within the reopen window a student's
# reply reopens it, after it they open a new ticket.
AUTO_CLOSE_AFTER_DAYS=7
REOPEN_WINDOW_DAYS=7
SLA_SWEEP_BATCH=500
SLA_SWEEP_SECONDS=30.0
