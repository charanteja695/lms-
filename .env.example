# docker compose settings for the whole backend stack. Copy to .env (docker compose reads it automatically).
# Each service's own settings are in <service>/.env.docker (copy <service>/.env.docker.example).

# --- PostgreSQL (one server, one database per service; the `databases` container creates them) ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_DB=lms_user_management
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible storage for development). The service env files carry the same credentials
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY); change both together. ---
MINIO_ROOT_USER=lms-minio
MINIO_ROOT_PASSWORD=lms-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Published ports of services (host side; every container listens on 8000) ---
USER_MANAGEMENT_PORT=8001
CATALOG_PORT=8002
MEDIA_PORT=8003
SUBSCRIPTION_PORT=8004
LEARNING_PORT=8005
CODE_EXECUTION_PORT=8006
ASSESSMENT_PORT=8007
PROCTORING_PORT=8008
CERTIFICATE_PORT=8009
NOTIFICATION_PORT=8016
AI_GATEWAY_PORT=8010
AI_TUTOR_PORT=8011
SUPPORT_PORT=8012
CAREER_PORT=8013
JOB_PORTAL_PORT=8014
INTERVIEW_PORT=8015
ANALYTICS_PORT=8017
BILLING_PORT=8018
API_GATEWAY_PORT=8000
