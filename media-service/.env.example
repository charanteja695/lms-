# ============================================================================================
# media-service: local settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-media-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
# Only enable behind a proxy you control; otherwise clients can spoof their IP.
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms_media
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0

# --- Access state published by user-management (read-only) ---
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Hashing: server-side pepper used to HMAC opaque playback tokens at rest ---
TOKEN_HASH_SECRET=insecure-dev-token-hash-secret-change-me-0

# --- Rate limiting (per client IP unless stated) ---
RATE_LIMIT_ENABLED=true
UPLOAD_URL_RATE_LIMIT_PER_HOUR=60
PLAYBACK_TOKEN_RATE_LIMIT_PER_MINUTE=60

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=media-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000

# --- Background worker (python -m app.worker: outbox relay + processing + inbound consumer) ---
WORKER_POLL_SECONDS=2.0

# --- AWS S3 (the only storage backend this service targets) ---
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_BUCKET=lms-media-dev
# Set only for local testing against a non-AWS S3-compatible endpoint (e.g. moto server);
# leave unset in staging/production so boto3 talks to real AWS S3.
# S3_ENDPOINT_URL=
S3_UPLOAD_URL_EXPIRES_SECONDS=900
S3_PLAYBACK_URL_EXPIRES_SECONDS=300

# --- Upload rules ---
MAX_UPLOAD_BYTES=5368709120
ALLOWED_VIDEO_CONTENT_TYPES=["video/mp4","video/quicktime","video/webm","video/x-matroska"]
ALLOWED_IMAGE_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]

# --- Playback ---
PLAYBACK_TOKEN_EXPIRE_MINUTES=240
