# ============================================================================================
# catalog-service: local settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-catalog-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
# Only enable behind a proxy you control; otherwise clients can spoof their IP.
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms_catalog
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Any single query running longer than this is cancelled, so one slow query cannot exhaust the pool.
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
# user-management's JWKS endpoint. Keys are cached in memory; see app/core/security.py.
USER_MANAGEMENT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0

# --- Access state published by user-management (read-only; see lms_common.access_state) ---
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Rate limiting (per client IP unless stated) ---
RATE_LIMIT_ENABLED=true
AUTHORING_RATE_LIMIT_PER_MINUTE=60
REVIEW_RATE_LIMIT_PER_MINUTE=60

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=catalog-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000

# --- Background worker (python -m app.worker: outbox relay + inbound event consumer) ---
WORKER_POLL_SECONDS=2.0

# --- Course rule defaults (configurable per course version; see app/models/course_rule.py) ---
DEFAULT_TOPIC_PASS_MARK=60
DEFAULT_MODULE_PASS_MARK=60
DEFAULT_FINAL_PASS_MARK=60
DEFAULT_FINAL_TEST_ATTEMPTS=3
DEFAULT_FINAL_TEST_COOLDOWN_DAYS=7
