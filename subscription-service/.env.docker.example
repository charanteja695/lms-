# ============================================================================================
# subscription-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-subscription-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_subscription
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream, entitlement cache) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0

# --- Access state published by user-management (read-only) ---
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Rate limiting (per client IP unless stated) ---
RATE_LIMIT_ENABLED=true
COURSE_REQUEST_RATE_LIMIT_PER_HOUR=30

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=subscription-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000

# --- Background worker (python -m app.worker: outbox relay + inbound event consumer) ---
WORKER_POLL_SECONDS=2.0

# --- Entitlement cache (Redis; read by learning-service, not built yet) ---
ENTITLEMENT_KEY_PREFIX=lms:entitlement

# --- Subscription rules ---
DEFAULT_SUBSCRIPTION_TERM_DAYS=365
MAX_SEATS_PER_SUBSCRIPTION_COURSE=100000

# --- Service-to-service auth for the seat endpoints (see app/api/deps.py::require_seat_caller) ---
# No service-identity scheme exists platform-wide yet (see README "Not yet wired"): this is a
# single shared secret, checked via the X-Internal-Service-Token header, until one does.
INTERNAL_SERVICE_TOKEN=**********
