# ============================================================================================
# certificate-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-certificate-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_certificate
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0

# --- Access state published by user-management (read-only) ---
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
PUBLIC_VERIFY_RATE_LIMIT_PER_IP_PER_MINUTE=60
AUTHORING_RATE_LIMIT_PER_HOUR=300
DOWNLOAD_RATE_LIMIT_PER_USER_PER_MINUTE=30

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=certificate-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14

# --- What a certificate says and where it can be verified (docs/PRODUCT.md §5.4) ---
ISSUER_NAME=LMS
# The public verification page (a frontend route): the QR code on a certificate encodes "<this>/<verification code>".
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify

# --- PDF generation (once per certificate, by the worker) ---
WORKER_POLL_SECONDS=2.0
PDF_BATCH_SIZE=10
PDF_LEASE_SECONDS=120
# A certificate whose student's name has not reached this service yet (the user event is still in flight) is
# retried with backoff this many times before it is marked failed for an admin to regenerate.
PDF_MAX_ATTEMPTS=8

# --- Object storage for the generated PDFs ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=lms-minio
AWS_SECRET_ACCESS_KEY=lms-minio-secret
S3_BUCKET=lms-certificates-dev
# Set only for local testing against a non-AWS S3-compatible endpoint; unset in staging/production.
S3_ENDPOINT_URL=http://minio:9000
S3_DOWNLOAD_URL_EXPIRES_SECONDS=300

# --- Housekeeping ---
HOUSEKEEPING_INTERVAL_SECONDS=3600.0
