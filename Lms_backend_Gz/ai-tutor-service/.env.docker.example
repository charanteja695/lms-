# ============================================================================================
# ai-tutor-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-ai-tutor-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_ai_tutor
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access
INTERNAL_SERVICE_TOKEN=**********

# --- Other services this one calls (synchronously, with the shared internal token) ---
AI_GATEWAY_URL=http://ai-gateway:8000
AI_GATEWAY_TIMEOUT_SECONDS=30.0
SUPPORT_SERVICE_URL=http://support-service:8000
SUPPORT_SERVICE_TIMEOUT_SECONDS=10.0
# Content indexing has no student behind it, so its embedding calls are billed to this organization in
# ai-gateway's per-org quotas (a platform-owned id; give it its own quota row there).
PLATFORM_ORGANIZATION_ID=1755000000000001

# --- Prompts registered in ai-gateway's prompt registry (see `python -m app.cli register-prompts`) ---
LEARNING_PROMPT_KEY=tutor.learning
SUPPORT_PROMPT_KEY=tutor.support
SUMMARY_PROMPT_KEY=tutor.escalation_summary

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
MESSAGE_RATE_LIMIT_PER_USER_PER_MINUTE=12
CONVERSATION_RATE_LIMIT_PER_USER_PER_HOUR=30
AUTHORING_RATE_LIMIT_PER_HOUR=300

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=ai-tutor-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14
WORKER_POLL_SECONDS=2.0
HOUSEKEEPING_INTERVAL_SECONDS=3600.0
# --- Retrieval (RAG). Vectors are stored as JSON and compared in-process (numpy) over one course version's
# chunks — fine for a course (hundreds to low thousands of chunks); pgvector is the next step (D5). ---
CHUNK_MAX_CHARS=1200
TRANSCRIPT_WINDOW_SECONDS=60
RETRIEVAL_TOP_K=5
# Cosine similarity below which a chunk is not shown to the model or cited.
MIN_RELEVANCE=0.3
# A top score under this is "low confidence" (docs/PRODUCT.md §5.5): no grounded answer is attempted.
LOW_CONFIDENCE_BELOW=0.35
# A published FAQ answer at or above this is returned as-is, without calling a model at all.
FAQ_DIRECT_ANSWER_AT=0.9
EMBED_BATCH_SIZE=32
INDEX_CACHE_VERSIONS=64

# --- Conversation behaviour ---
HISTORY_MESSAGES=10
HISTORY_MAX_CHARS=6000
MAX_MESSAGE_CHARS=4000
MAX_CODE_CHARS=8000
MAX_TOKENS=800
# Consecutive "could not ground this" answers in one conversation before it is escalated to a person.
LOW_CONFIDENCE_ESCALATE_AFTER=2
# A graded attempt blocks the tutor until it is submitted, or its deadline plus this grace has passed
# (so a lost attempt.submitted event cannot leave a student locked out).
TEST_BLOCK_GRACE_SECONDS=300
# Hint ladder for practice problems: 1 nudge, 2 approach, 3 pseudocode, 4 solution (only after 3 hints).
MAX_HINT_LEVEL=4
CONVERSATION_RETENTION_DAYS=180

# --- Escalation delivery to support-service (durable: retried with backoff by the worker) ---
ESCALATION_BATCH_SIZE=20
ESCALATION_LEASE_SECONDS=60
ESCALATION_MAX_ATTEMPTS=8
SUMMARY_MESSAGES=12

# --- Indexing jobs ---
INDEX_BATCH_SIZE=5
INDEX_LEASE_SECONDS=300
INDEX_MAX_ATTEMPTS=6
