# ============================================================================================
# ai-interview-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-ai-interview-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_interview
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access
INTERNAL_SERVICE_TOKEN=**********

# --- Other services (synchronous calls use the internal token) ---
AI_GATEWAY_URL=http://ai-gateway:8000
AI_GATEWAY_TIMEOUT_SECONDS=60.0
CODE_EXECUTION_URL=http://code-execution-service:8000
CODE_EXECUTION_TIMEOUT_SECONDS=45.0
PLATFORM_ORGANIZATION_ID=1755000000000001
MAX_TOKENS=700
EVAL_MAX_TOKENS=3000

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
WRITE_RATE_LIMIT_PER_USER_PER_MINUTE=60
TURN_RATE_LIMIT_PER_INTERVIEW_PER_MINUTE=30
CODE_RUN_LIMIT_PER_INTERVIEW=40

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=ai-interview-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14
WORKER_POLL_SECONDS=2.0
HOUSEKEEPING_INTERVAL_SECONDS=3600.0

# --- Interviews (docs/PRODUCT.md §5.8) ---
MOCK_INTERVIEWS_PER_MONTH=5
INVITE_VALID_DAYS=7
START_GRACE_MINUTES=15
OVERRUN_GRACE_SECONDS=60
MAX_TURN_CHARS=4000
MAX_TURNS_PER_INTERVIEW=120
MAX_FOLLOW_UPS_PER_QUESTION=2
MAX_CODE_CHARS=20000
CODE_RUN_WAIT_SECONDS=15.0
SPEECH_ENABLED=true

# --- Evaluation ---
# The recommendation is computed from the weighted rubric score, never chosen by the model.
STRONG_YES_AT=4.2
YES_AT=3.4
LEAN_NO_AT=2.6
MIN_EVIDENCE_FOR_EXTREME_SCORE=1
FEEDBACK_AFTER_REVIEW=true
APPEAL_WINDOW_DAYS=7
AUDIT_MIN_GROUP=10
CALIBRATION_MAX_SAMPLES=20

# --- Work queue (leased with SKIP LOCKED; retried with backoff) ---
WORK_LEASE_SECONDS=180
WORK_MAX_ATTEMPTS=6
WORK_BACKOFF_BASE_SECONDS=30
WORK_BATCH=10
WORK_RETENTION_DAYS=14
