# ============================================================================================
# analytics-service: local settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-analytics-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables). PostgreSQL, not ClickHouse: D12. ---
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms_analytics
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
WRITE_RATE_LIMIT_PER_HOUR=200

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=analytics-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=30
WORKER_POLL_SECONDS=2.0
HOUSEKEEPING_INTERVAL_SECONDS=3600.0

# --- Rollups (docs/PRODUCT.md §5.9 "Aggregation") ---
ROLLUP_INTERVAL_SECONDS=300.0
ROLLUP_TAIL_DAYS=2
DASHBOARD_ROLLUP_CUTOFF_DAYS=1
RAW_EVENT_RETENTION_DAYS=400

# --- Scheduled reports ---
REPORT_CHECK_INTERVAL_SECONDS=300.0
REPORT_MAX_ROWS=5000
REPORT_RUN_RETENTION_COUNT=20
