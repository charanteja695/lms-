# ============================================================================================
# user-management: local settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-user-management
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
# Only enable behind a proxy you control; otherwise clients can spoof their IP.
TRUST_PROXY_HEADERS=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms_user_management
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Any single query running longer than this is cancelled, so one slow query cannot exhaust the pool.
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# RS256 is recommended for microservices: other services verify tokens with the
# public key (served at /.well-known/jwks.json) and never hold the signing key.
JWT_ALGORITHM=RS256
JWT_SECRET_KEY=insecure-dev-jwt-secret-change-me-000000000
JWT_PRIVATE_KEY_FILE=keys/jwt_private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt_public.pem
JWT_KEY_ID=lms-user-management-1
# Key rotation: keep the previous public key published (and accepted) until its tokens have expired.
# JWT_PREVIOUS_PUBLIC_KEY_FILE=
# JWT_PREVIOUS_KEY_ID=
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_MAX_LIFETIME_DAYS=30

# --- Browser sessions: refresh token in an httpOnly cookie (clients opt in with X-Session-Transport: cookie) ---
REFRESH_COOKIE_NAME=lms_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
# REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict

# --- Access state shared with other services (see app/core/access_state.py) ---
ACCESS_STATE_KEY_PREFIX=lms:access
# Other services call /internal with this shared secret (the same value in every service's settings).
INTERNAL_SERVICE_TOKEN=insecure-dev-internal-service-token-change-me-0

# --- Hashing ---
# Server-side pepper used to HMAC refresh tokens, OTPs and reset links at rest.
TOKEN_HASH_SECRET=insecure-dev-token-hash-secret-change-me-0
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
# Password hashes computed at once per instance. Each uses ARGON2_MEMORY_COST_KIB of RAM, so this bounds
# memory during login bursts (e.g. 8 x 64 MB = 512 MB). Scale out instances for more throughput.
PASSWORD_HASH_CONCURRENCY=8

# --- Data defaults & rules ---
# Used to interpret phone numbers entered without a +country code, and as profile defaults.
DEFAULT_COUNTRY_CODE=IN
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=en
STUDENT_MIN_AGE=3
EMPLOYEE_MIN_AGE=18
GUARDIAN_REQUIRED_BELOW_AGE=18

# --- Password policy & lockout ---
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Password reset & account set-up ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRE_MINUTES=15
ACCOUNT_SETUP_EXPIRE_HOURS=72
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_LOGIN_PATH=/login
FRONTEND_RESET_PASSWORD_PATH=/reset-password
FRONTEND_ACCOUNT_SETUP_PATH=/set-password

# --- Self sign-up (individual learners who buy courses themselves) ---
SIGNUP_ENABLED=true
SIGNUP_RATE_LIMIT_PER_HOUR=10
SIGNUP_EMAIL_RATE_LIMIT_PER_HOUR=5
# The one organisation every self-registered learner belongs to (created on the first sign-up).
INDIVIDUAL_ORG_NAME=Individual learners
INDIVIDUAL_ORG_CODE=INDIVIDUAL
INDIVIDUAL_ORG_EMAIL=learners@example.com
INDIVIDUAL_ORG_PHONE=+910000000000
INDIVIDUAL_ORG_ADDRESS=Online
INDIVIDUAL_ORG_CITY=Online
INDIVIDUAL_ORG_STATE=Online
INDIVIDUAL_ORG_POSTAL_CODE=000000

# --- Rate limiting (per client IP unless stated) ---
RATE_LIMIT_ENABLED=true
# per client IP: a school shares one IP, so sized for a classroom; brute force is stopped per account (lockout)
LOGIN_RATE_LIMIT_PER_MINUTE=120
REFRESH_RATE_LIMIT_PER_MINUTE=600
FORGOT_PASSWORD_RATE_LIMIT_PER_HOUR=20
FORGOT_PASSWORD_IDENTIFIER_RATE_LIMIT_PER_HOUR=5
OTP_VERIFY_RATE_LIMIT_PER_MINUTE=10
RESET_PASSWORD_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_PER_HOUR=30

# --- Export ---
EXPORT_MAX_ROWS=500000
EXPORT_BATCH_SIZE=2000

# --- Housekeeping (python -m app.cli purge-expired) ---
# Keep ended sessions this long for audit
SESSION_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=7

# --- Two-factor authentication (TOTP) ---
MFA_ISSUER=LMS
# TEST SERVERS ONLY: a fixed 6-digit code accepted as the two-factor code (besides the app's real codes), so testers
# need no authenticator app. Refused outside local/test; leave unset everywhere else.
# MFA_TEST_CODE=
# Roles that must enrol before they can use the API (they may still reach /users/me, logout and MFA set-up).
MFA_REQUIRED_ROLES=["super_admin"]
# Fernet key (32 url-safe base64 bytes) used to encrypt TOTP secrets at rest. Required outside local/test.
# MFA_ENCRYPTION_KEY=
MFA_CHALLENGE_EXPIRE_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_RECOVERY_CODE_COUNT=10
MFA_VERIFY_RATE_LIMIT_PER_MINUTE=10

# --- Bulk import ---
IMPORT_MAX_ROWS=5000
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_RATE_LIMIT_PER_HOUR=20
# Larger files go through POST /users/import-jobs and are processed by the worker.
IMPORT_JOB_MAX_ROWS=50000
IMPORT_JOB_MAX_FILE_BYTES=52428800

# --- Background jobs & worker (python -m app.worker) ---
JOB_STORAGE_DIR=var\jobs
EXPORT_FILE_TTL_HOURS=72
WORKER_POLL_SECONDS=2.0
WORKER_PURGE_INTERVAL_MINUTES=60
JOB_MAX_ATTEMPTS=3
FRONTEND_JOBS_PATH=/downloads

# --- Events (transactional outbox relayed by the worker) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500

# --- Email ---
EMAIL_BACKEND=console
EMAIL_FROM=LMS <no-reply@lms.local>
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
