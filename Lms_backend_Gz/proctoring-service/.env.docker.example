# ============================================================================================
# proctoring-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-proctoring-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_proctoring
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (ready flags read by assessment-service, rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Service-to-service: the shared secret assessment-service checks on its /internal/* ---
INTERNAL_SERVICE_TOKEN=**********
ASSESSMENT_SERVICE_URL=http://assessment-service:8000
ASSESSMENT_SERVICE_TIMEOUT_SECONDS=5.0
# assessment-service reads this Redis key to know a student passed the pre-check before it starts their clock.
READY_KEY_PREFIX=lms:proctor:ready
READY_TTL_SECONDS=7200
# --- AI analysis of snapshots and audio (docs/PRODUCT.md §5.3). Unset: snapshots are stored but not analysed, and
# every report says so. The analyzer is any HTTP service implementing app/clients/analyzer.py's contract. ---
# AI_ANALYZER_URL=
# AI_ANALYZER_TOKEN=
AI_ANALYZER_TIMEOUT_SECONDS=20.0
AI_MIN_CONFIDENCE=0.6

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
EVENTS_RATE_LIMIT_PER_SESSION_PER_MINUTE=120
SNAPSHOT_RATE_LIMIT_PER_SESSION_PER_MINUTE=12

# --- Sessions and pre-check ---
CONSENT_VERSION=2026-09
MIN_BANDWIDTH_KBPS_STRICT=300
SNAPSHOT_INTERVAL_SECONDS=25
# Strict: a short microphone clip every AUDIO_INTERVAL_SECONDS for the voice check (0 turns clips off).
AUDIO_INTERVAL_SECONDS=60
AUDIO_CLIP_SECONDS=8
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_LOST_AFTER_SECONDS=60
MAX_EVENTS_PER_REQUEST=100
CLIENT_CLOCK_SKEW_SECONDS=300
S3_UPLOAD_URL_EXPIRES_SECONDS=300
S3_DOWNLOAD_URL_EXPIRES_SECONDS=120
MAX_SNAPSHOT_MB=5

# --- Risk and integrity decisions (app/risk/policy.py has the per-event weights) ---
# At or below this a finished attempt is cleared automatically; above it (or on any critical finding) a person decides.
RISK_CLEAR_MAX=25
RISK_FLAG_MIN=50
# After submission, wait this long for pending snapshot analysis before deciding on what is known.
ANALYSIS_WAIT_SECONDS=300
APPEAL_WINDOW_DAYS=7
MIN_INVALIDATION_NOTE_CHARS=10
# Cases nobody has decided after this long are listed as overdue (never decided automatically).
CASE_OVERDUE_HOURS=72

# --- Analysis queue ---
ANALYSIS_BATCH=20
ANALYSIS_LEASE_SECONDS=120
ANALYSIS_MAX_ATTEMPTS=4
# Under load (docs/PRODUCT.md §8: "sampling when under load"): above this many waiting snapshots only every
# ANALYSIS_SAMPLE_EVERY-th periodic snapshot of a session is analysed; the rest are stored and marked sampled out.
ANALYSIS_BACKLOG_SAMPLING_THRESHOLD=5000
ANALYSIS_SAMPLE_EVERY=3

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=proctoring-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14
WORKER_POLL_SECONDS=2.0

# --- Privacy (DPDP Act): media is kept for a fixed period and then deleted from storage ---
MEDIA_RETENTION_DAYS=90
EVENTS_RETENTION_DAYS=365

# --- Object storage for snapshots (direct-to-S3 uploads) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=lms-minio
AWS_SECRET_ACCESS_KEY=lms-minio-secret
S3_BUCKET=lms-proctoring-dev
# Set only for local testing against a non-AWS S3-compatible endpoint; unset in staging/production.
S3_ENDPOINT_URL=http://minio:9000

# --- Housekeeping ---
HOUSEKEEPING_INTERVAL_SECONDS=3600.0
