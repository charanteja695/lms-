# ============================================================================================
# learning-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-notification-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_notification
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0

# --- Access state published by user-management (read-only) ---
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Rate limiting (per client IP unless stated) ---
RATE_LIMIT_ENABLED=true
NOTIFICATION_WRITE_RATE_LIMIT_PER_HOUR=600

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=notification-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000

# --- Background worker (python -m app.worker: outbox relay + inbound event consumer) ---
WORKER_POLL_SECONDS=2.0

# --- Delivery (worker sweep: pending emails are claimed, sent, then retried with backoff) ---
DELIVERY_BATCH_SIZE=50
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_SECONDS=60
DELIVERY_RETRY_MAX_SECONDS=21600
# A claimed delivery that is neither sent nor failed within this window is retried (worker crash).
DELIVERY_CLAIM_LEASE_SECONDS=120

# --- Housekeeping ---
PROCESSED_EVENTS_RETENTION_DAYS=7
HOUSEKEEPING_INTERVAL_SECONDS=3600.0

# --- Email channel ---
EMAIL_BACKEND=console
EMAIL_FROM=LMS <no-reply@lms.local>
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
# Exposed to templates as ${app_url}.
FRONTEND_BASE_URL=http://localhost:3000
