# ============================================================================================
# job-portal-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-job-portal-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_job_portal
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access
INTERNAL_SERVICE_TOKEN=**********

# --- Other services (synchronous calls use the internal token) ---
AI_GATEWAY_URL=http://ai-gateway:8000
AI_GATEWAY_TIMEOUT_SECONDS=45.0
ASSESSMENT_SERVICE_URL=http://assessment-service:8000
ASSESSMENT_SERVICE_TIMEOUT_SECONDS=10.0
CAREER_SERVICE_URL=http://career-service:8000
CAREER_SERVICE_TIMEOUT_SECONDS=10.0
PLATFORM_ORGANIZATION_ID=1755000000000001
MAX_TOKENS=700

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
WRITE_RATE_LIMIT_PER_USER_PER_MINUTE=60
APPLY_RATE_LIMIT_PER_USER_PER_HOUR=30
AI_RATE_LIMIT_PER_USER_PER_HOUR=60

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=job-portal-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14
WORKER_POLL_SECONDS=2.0
HOUSEKEEPING_INTERVAL_SECONDS=3600.0

# --- Jobs ---
MAX_OPEN_JOBS_PER_EMPLOYER=200
MAX_SKILLS_PER_JOB=30

# --- Matching (docs/PRODUCT.md §5.7) ---
# A match score is the sum of these weights' shares; they must add up to 100.
MATCH_WEIGHT_SKILLS=50
MATCH_WEIGHT_SEMANTIC=20
MATCH_WEIGHT_CERTIFICATES=10
MATCH_WEIGHT_PREFERENCES=20
MATCH_STORE_MIN_SCORE=30
MATCH_NOTIFY_MIN_SCORE=70
MATCH_BATCH_SIZE=200
RECOMMENDATIONS_DEFAULT_LIMIT=20

# --- Applications and screening ---
SCREEN_AI_ENABLED=true
SCREEN_SHORTLIST_DEFAULT_THRESHOLD=70
SCREEN_REJECT_BELOW=40
OFFER_DEFAULT_VALID_DAYS=7
ASSESSMENT_INVITE_VALID_DAYS=7

# --- Work queue (leased with SKIP LOCKED; retried with backoff) ---
WORK_LEASE_SECONDS=120
WORK_MAX_ATTEMPTS=6
WORK_BACKOFF_BASE_SECONDS=30
WORK_BATCH=10
WORK_RETENTION_DAYS=14
