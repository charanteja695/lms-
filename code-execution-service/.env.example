# ============================================================================================
# learning-service: local settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-code-execution-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms_code_execution
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0

# --- Access state published by user-management (read-only) ---
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Callers that are services, not people (assessment-service submits on a student's behalf) ---
# Same shared-secret scheme as subscription-service's seat endpoints: there is no per-service identity yet.
INTERNAL_SERVICE_TOKEN=**********

# --- Rate limits: per user and per institution, per minute (docs/PRODUCT.md §5.2) ---
RATE_LIMIT_ENABLED=true
RUN_RATE_LIMIT_PER_USER_PER_MINUTE=20
RUN_RATE_LIMIT_PER_ORG_PER_MINUTE=600
SUBMISSION_RATE_LIMIT_PER_USER_PER_MINUTE=10
SUBMISSION_RATE_LIMIT_PER_ORG_PER_MINUTE=300
AUTHORING_RATE_LIMIT_PER_HOUR=600

# --- Events (transactional outbox relayed by the worker) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500

# --- Execution engine ---
# judge0: a self-hosted Judge0-compatible engine (docs/PRODUCT.md D4), the only choice outside
# local/test. local: runs code as a plain subprocess of this machine with NO isolation, for
# development and tests only (only languages that declare a local command).
EXECUTION_ENGINE=local
JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=
JUDGE0_TIMEOUT_SECONDS=30.0
LANGUAGES_FILE=runtimes/languages.json

# --- Limits on what a caller may send and what a run may use ---
MAX_SOURCE_BYTES=65536
MAX_STDIN_BYTES=65536
MAX_OUTPUT_BYTES=65536
RUN_CPU_TIME_SECONDS=5.0
RUN_WALL_TIME_SECONDS=10.0
RUN_MEMORY_MB=256
PROBLEM_MAX_TIME_LIMIT_MS=15000
PROBLEM_MAX_MEMORY_MB=512
MAX_TEST_CASES_PER_PROBLEM=200
MAX_TEST_CASE_BYTES=1000000

# --- SQL problems: the student's query runs in a throw-away database ---
SQL_MAX_ROWS=1000
# PostgreSQL dialect: a low-privilege role on a DEDICATED sandbox cluster (never the service database).
# SQL_POSTGRES_DSN=

# --- Job queue (runs and submissions are rows claimed by workers with a lease) ---
JOB_BATCH_SIZE=10
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
WORKER_CONCURRENCY=8
JUDGE_CASE_CONCURRENCY=4
WORKER_POLL_SECONDS=0.5
RESULT_WAIT_MAX_SECONDS=30.0
RESULT_POLL_INTERVAL_SECONDS=0.25

# --- Test case encryption at rest: comma-separated Fernet keys, newest first; older keys only decrypt ---
TEST_CASE_ENCRYPTION_KEYS=**********

# --- Plagiarism (token fingerprints, docs/PRODUCT.md §5.2) ---
SIMILARITY_FLAG_PERCENT=80
SIMILARITY_LIST_MIN_PERCENT=30
SIMILARITY_MIN_TOKENS=30
FINGERPRINT_MAX_HASHES=500

# --- Housekeeping ---
RUNS_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_HOURS=24
HOUSEKEEPING_INTERVAL_SECONDS=3600.0
