# ============================================================================================
# learning-service: local settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-learning-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms_learning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0

# --- Access state published by user-management (read-only) ---
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Rate limiting (per client IP unless stated) ---
RATE_LIMIT_ENABLED=true
ENROLLMENT_RATE_LIMIT_PER_HOUR=200

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=learning-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000

# --- Background worker (python -m app.worker: outbox relay + inbound event consumer) ---
WORKER_POLL_SECONDS=2.0

# --- subscription-service: seat reserve/release on enrol/withdraw (docs/PRODUCT.md §6.1) ---
SUBSCRIPTION_SERVICE_URL=http://localhost:8004
SUBSCRIPTION_SERVICE_TIMEOUT_SECONDS=5.0
# Same shared secret subscription-service checks in app/api/deps.py::require_seat_caller.
INTERNAL_SERVICE_TOKEN=**********
# Same Redis keyspace subscription-service writes to (see app/clients/entitlement_cache.py).
ENTITLEMENT_KEY_PREFIX=lms:entitlement
