# ============================================================================================
# assessment-service: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-assessment-service
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
TRUST_PROXY_HEADERS=false

# --- Database (own database; never read another service's tables) ---
DATABASE_URL=postgresql+asyncpg://lms:lms@postgres:5432/lms_assessment
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (answer buffer, paper cache, waiting room, rate limiting, access-state reads, event stream) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: this service only verifies tokens, it never issues them ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0

# --- Access state published by user-management (read-only) ---
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Service-to-service: the same shared secret code-execution-service checks on /internal/* ---
# (proctoring-service and job-portal-service call this service's /internal/* with it too; there is no
# per-service identity scheme yet — same caveat as subscription-service's seat endpoints.)
INTERNAL_SERVICE_TOKEN=**********
CODE_EXECUTION_URL=http://code-execution-service:8000
CODE_EXECUTION_TIMEOUT_SECONDS=10.0

# --- Events (transactional outbox relayed by the worker; consumed from lms:events) ---
EVENTS_STREAM=lms:events
EVENTS_STREAM_MAX_LENGTH=1000000
OUTBOX_BATCH_SIZE=500
EVENTS_CONSUMER_GROUP=assessment-service
EVENTS_CONSUMER_NAME=worker-1
EVENTS_BLOCK_MS=5000
PROCESSED_EVENTS_RETENTION_DAYS=14

# --- Rate limits (per user, per minute) ---
RATE_LIMIT_ENABLED=true
ANSWER_SAVE_RATE_LIMIT_PER_USER_PER_MINUTE=600
ATTEMPT_CREATE_RATE_LIMIT_PER_USER_PER_MINUTE=20
FILE_URL_RATE_LIMIT_PER_USER_PER_MINUTE=30
AUTHORING_RATE_LIMIT_PER_HOUR=1200

# --- Authoring limits ---
MAX_SECTIONS_PER_TEST=20
MAX_QUESTIONS_PER_TEST=300
# What a course test must hold before it can be published (0 turns a rule off). Multiple choice = single or
# multi answer; a program = a coding question judged against test cases.
TOPIC_TEST_MIN_MCQ=5
TOPIC_TEST_MIN_PROGRAMS=1
FINAL_TEST_MIN_MCQ=10
FINAL_TEST_MIN_PROGRAMS=2
MAX_OPTIONS_PER_QUESTION=12
MAX_TEXT_BYTES=20000
BULK_IMPORT_MAX_QUESTIONS=200

# --- Proctoring pre-check (proctoring-service publishes a Redis "ready" key when a student passes it) ---
# A proctored test (basic or strict) cannot be started until the student's pre-check has passed. If Redis cannot
# be read the start is allowed (and logged): an outage must not lock every student out of their exam.
PROCTORING_PRECHECK_REQUIRED=true
PROCTORING_READY_KEY_PREFIX=lms:proctor:ready

# --- Attempts: the server-side timer is the authority (docs/PRODUCT.md §5.1) ---
# A save or submit that arrives this long after the deadline is still accepted (network latency, a slow
# client clock is irrelevant since only the server clock counts); later ones are refused.
ATTEMPT_GRACE_SECONDS=10
# A prepared (not started) attempt is dropped after this long without being started.
PREPARED_ATTEMPT_TTL_HOURS=12
# Waiting room: a scheduled exam accepts attempt preparation this long before it opens.
WAITING_ROOM_LEAD_MINUTES=30
# Starts admitted per second per test when an exam opens; the rest are told to retry (staggered start).
WAITING_ROOM_ADMIT_PER_SECOND=500
MAX_ANSWER_BYTES=70000
MAX_ANSWERS_PER_BATCH=50

# --- Question paper generation ---
POOL_CACHE_SECONDS=300
POOL_MAX_CANDIDATES=5000

# --- Answer buffer: writes hit Redis first and are flushed to the database in batches ---
# "direct" writes straight to the database (also the automatic fallback when Redis is unavailable).
ANSWER_BUFFER=redis
ANSWER_FLUSH_INTERVAL_SECONDS=2.0
ANSWER_FLUSH_BATCH_ATTEMPTS=200
ANSWER_BUFFER_TTL_HOURS=48

# --- Grading queue (submitted attempts are rows claimed by workers with a lease) ---
JOB_BATCH_SIZE=50
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=8
WORKER_POLL_SECONDS=1.0
TIMEOUT_SWEEP_BATCH=500

# --- Coding and SQL questions are judged by code-execution-service ---
CODE_DISPATCH_BATCH=50
CODE_DISPATCH_MAX_ATTEMPTS=6
# A dispatched submission whose verdict event has not arrived is asked for directly after this long.
CODE_RECONCILE_AFTER_SECONDS=60
# After this long without a verdict the answer is graded 0 and flagged for a human (never left hanging).
CODE_GIVE_UP_MINUTES=30

# --- Proctoring integrity (proctoring-service emits integrity.*; docs/PRODUCT.md §5.3) ---
# A proctored attempt waits for a human-confirmed or automatic integrity decision. Overdue ones are listed for
# exams.manage; nothing is ever decided automatically on their behalf.
INTEGRITY_DECISION_OVERDUE_HOURS=72

# --- Item statistics (difficulty index, discrimination) ---
STATS_MIN_SAMPLE=30
STATS_SAMPLE_LIMIT=5000
STATS_INTERVAL_SECONDS=60.0

# --- Object storage for file/project answers (presigned direct-to-S3 uploads) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=lms-minio
AWS_SECRET_ACCESS_KEY=lms-minio-secret
S3_BUCKET=lms-assessment-dev
# Set only for local testing against a non-AWS S3-compatible endpoint; unset in staging/production.
S3_ENDPOINT_URL=http://minio:9000
S3_UPLOAD_URL_EXPIRES_SECONDS=900
S3_DOWNLOAD_URL_EXPIRES_SECONDS=300
ANSWER_FILE_MAX_MB=25
MAX_FILES_PER_ANSWER=10

# --- Housekeeping ---
IDEMPOTENCY_RETENTION_HOURS=24
HOUSEKEEPING_INTERVAL_SECONDS=3600.0
