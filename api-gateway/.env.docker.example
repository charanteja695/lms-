# ============================================================================================
# api-gateway: docker compose settings
# Generated by scripts/generate_env_example.py from app/core/config.py. Copy to .env.docker and edit
# values there; never commit real secrets. Staging/production refuse to start with development values.
# ============================================================================================


# --- Application ---
APP_NAME=lms-api-gateway
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
# The browser origins allowed to call the platform. This is the only place CORS is applied: services' own CORS headers are dropped
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]
# Believe X-Forwarded-For from the load balancer in front of the gateway (only behind one you control)
TRUST_PROXY_HEADERS=true

# --- Redis (rate limiting and the revocation state user-management publishes) ---
REDIS_URL=redis://redis:6379/0

# --- Authentication: an Authorization header, if sent, must be valid; the services still verify it themselves ---
USER_MANAGEMENT_JWKS_URL=http://user-management:8000/.well-known/jwks.json
JWT_ISSUER=lms-user-management
JWT_AUDIENCE=lms
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5.0
ACCESS_STATE_KEY_PREFIX=lms:access

# --- Routing ---
# JSON object of service name -> base URL, overriding the local defaults for the services it names
UPSTREAM_URLS={"user-management": "http://user-management:8000", "catalog-service": "http://catalog-service:8000", "media-service": "http://media-service:8000", "subscription-service": "http://subscription-service:8000", "learning-service": "http://learning-service:8000", "code-execution-service": "http://code-execution-service:8000", "assessment-service": "http://assessment-service:8000", "proctoring-service": "http://proctoring-service:8000", "certificate-service": "http://certificate-service:8000", "ai-gateway": "http://ai-gateway:8000", "ai-tutor-service": "http://ai-tutor-service:8000", "support-service": "http://support-service:8000", "career-service": "http://career-service:8000", "job-portal-service": "http://job-portal-service:8000", "ai-interview-service": "http://ai-interview-service:8000", "notification-service": "http://notification-service:8000", "analytics-service": "http://analytics-service:8000", "billing-service": "http://billing-service:8000"}
# Larger request bodies are refused (spoken interview answers are the biggest legitimate ones)
MAX_BODY_BYTES=33554432
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5.0
UPSTREAM_READ_TIMEOUT_SECONDS=120.0
# For server-sent-event streams (a path ending /stream)
STREAM_READ_TIMEOUT_SECONDS=3600.0
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# --- Rate limiting: fixed one-minute windows, per user when a valid token is sent, per client IP otherwise ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_PER_MINUTE=600
RATE_LIMIT_ANONYMOUS_PER_MINUTE=120
# Per IP, for sign-in, token refresh and password-reset paths (/api/v1/auth); a school shares one IP
RATE_LIMIT_AUTH_PER_MINUTE=600
